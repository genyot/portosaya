{
  "version": 2,
  "buildCommand": "composer install --no-interaction --prefer-dist --optimize-autoloader && npm install && npm run build",
  "framework": "laravel",
  "functions": {
    "api/bootstrap.php": {
      "runtime": "vercel-php@0.7.3",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/bootstrap.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "LOG_CHANNEL": "stderr"
  }
}
