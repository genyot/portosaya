{
  "version": 2,
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/bootstrap.php": {
      "runtime": "vercel-php@0.7.3",
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/storage/(.*)",
      "dest": "/public/storage/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/bootstrap.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "LOG_CHANNEL": "stderr",
    "VERCEL": "true"
  }
}
